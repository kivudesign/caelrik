{
  "name": "@celerikui/ui",
  "version": "0.6.0",
  "description": "The JavaScript and CSS bundle of Celerik UI, the accessible Bootstrap-based PHP component suite.",
  "homepage": "https://kivudesign.github.io/celerik/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kivudesign/celerik.git"
  },
  "bugs": "https://github.com/kivudesign/celerik/issues",
  "keywords": [
    "ui",
    "components",
    "bootstrap",
    "php",
    "laravel",
    "symfony",
    "accessibility"
  ],
  "files": [
    "public/**/*.js",
    "public/**/*.css"
  ],
  "browser": "./public/celerik.js",
  "style": "./public/celerik.css",
  "exports": {
    ".": "./public/celerik.js",
    "./celerik.css": "./public/celerik.css",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint resources/js tests/js tests/browser site playwright.config.mjs playwright.site.config.mjs tests/site",
    "pretest": "php tests/js/fixtures/build.php",
    "test": "jest",
    "test:a11y": "playwright test",
    "test:site": "playwright test -c playwright.site.config.mjs",
    "docs:demos": "php site/demos/build.php",
    "docs:reference": "php site/tools/reference.php",
    "docs:generate": "npm run docs:demos && npm run docs:reference",
    "predocs:dev": "npm run docs:generate",
    "predocs:build": "npm run docs:generate",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "jquery": "^3.7.1 || ^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@zxing/library": "^0.23.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.10.2",
    "babel-jest": "^30.5.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.4.7",
    "codemirror": "^6.0.2",
    "datatables.net-bs5": "^3.1.5",
    "datatables.net-buttons-bs5": "^4.1.3",
    "dompurify": "^3.4.17",
    "eslint": "^10.15.0",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "globals": "^17.14.0",
    "inputmask": "^5.0.9",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "marked": "^18.1.3",
    "notyf": "^3.10.0",
    "parsleyjs": "^2.9.2",
    "pdfjs-dist": "^6.5.438",
    "plyr": "^3.8.5",
    "quill": "^2.0.3",
    "sass": "^1.83.0",
    "sortablejs": "^1.15.7",
    "tom-select": "^2.6.2",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    }
  }
}
